---
import { Font, Image } from 'astro:assets';
import '../styles/global.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/motion.css';
import '../styles/mobile.css';
import monogram from '../assets/brand/logo-monogram.png';
import Header from '../components/Header.astro';
import TabBar from '../components/TabBar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
import { buildGraph, type Crumb } from '../lib/schema';

interface Props {
  /** Titlul paginii. Pe prima pagină se folosește exact; pe restul se adaugă „| Noir District”. */
  title: string;
  description: string;
  /** Cale către o imagine din /public, 1200×630. */
  image?: string;
  imageAlt?: string;
  /** Firimituri de pâine pentru subpagini (fără „Acasă”, care se adaugă automat). */
  crumbs?: Crumb[];
  noindex?: boolean;
  /** Identificator pentru animațiile specifice paginii (`home` pe prima pagină). */
  page?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = `${business.name} – frizerie în Piatra Neamț`,
  crumbs,
  noindex = false,
  page,
} = Astro.props;

const site = Astro.site!;
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? title : `${title} | ${business.name}`;
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
const jsonLd = buildGraph({ site, url: canonical, title: fullTitle, description, image: imageUrl, crumbs });

// Navigarea între pagini devine instantanee în Chrome/Edge: pagina e pre-randată când utilizatorul
// începe să interacționeze cu link-ul. Fără JavaScript executat de noi.
const speculationRules = {
  prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!--
      Sincron, înainte de prima randare: decide dacă pagina are animații (clasa `motion`) și dacă
      se arată intro-ul (prima vizită pe prima pagină, o dată pe sesiune). Cine are „reducere animații”
      sau „economisire date” primește pagina statică. Dacă JavaScript-ul nu pornește în 3,5 s,
      clasele se scot, ca nimic să nu rămână ascuns.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (navigator.connection && navigator.connection.saveData) return;
        d.classList.add('motion');
        try {
          if (location.pathname === '/' && !location.hash && !sessionStorage.getItem('nd-intro')) d.classList.add('intro');
        } catch (e) {}
        setTimeout(function () {
          if (!window.__motion) d.classList.remove('motion', 'intro');
        }, 3500);
      })();
    </script>

    <Font cssVariable="--font-display" preload />

    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="speculationrules" set:html={JSON.stringify(speculationRules)} />
    <slot name="head" />
  </head>
  <body data-page={page}>
    <div class="curtain" aria-hidden="true">
      <div class="curtain-inner">
        <Image src={monogram} alt="" width={96} densities={[1, 2]} class="curtain-mono" loading="eager" />
        <span class="curtain-line"></span>
      </div>
    </div>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <Header />
    <main id="continut">
      {crumbs && <Breadcrumbs crumbs={crumbs} />}
      <slot />
    </main>
    <Footer />
    <TabBar />
    <script>
      import '../scripts/motion/index';
    </script>
  </body>
</html>
