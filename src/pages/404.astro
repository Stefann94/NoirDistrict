---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina nu există" description="Pagina căutată nu există." noindex>
  <section class="container page-head notfound">
    <p class="eyebrow">404</p>
    <h1>Pagina asta a fost tunsă.</h1>
    <p class="lead">Adresa nu mai există sau a fost scrisă greșit.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Înapoi acasă</a>
      <a class="btn btn-ghost" href="/servicii/">Vezi prețurile</a>
    </div>
  </section>
</Base>
