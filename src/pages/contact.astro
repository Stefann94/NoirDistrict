---
import Base from '../layouts/Base.astro';
import Location from '../components/Location.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { business, bookingHref, socialLinks } from '../data/business';

const title = 'Contact, adresă și program';
const description = `Adresa, telefonul și programul frizeriei ${business.name} din Piatra Neamț. Programează-te sau găsește-ne pe Google Maps și Waze.`;
---

<Base title={title} description={description} crumbs={[{ name: 'Contact', path: '/contact/' }]}>
  <header class="container page-head">
    <p class="eyebrow">Contact</p>
    <h1>Contact și program</h1>
    <p class="lead">Lucrăm cu programare. Sună-ne sau rezervă online și te așteptăm la ora stabilită.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={bookingHref}>Programează-te</a>
    </div>
  </header>

  <section class="section" aria-label="Adresă și program">
    <div class="container">
      <Location />

      {socialLinks.length > 0 && (
        <ul class="social-row">
          {socialLinks.map((s) => (
            <li>
              <a class="btn btn-ghost" href={s.url} target="_blank" rel="noopener me">
                <Icon name={s.network as IconName} size={18} /> {s.network}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
