---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Frame from '../components/Frame.astro';
import ServiceList from '../components/ServiceList.astro';
import Booking from '../components/Booking.astro';
import Location from '../components/Location.astro';
import Icon from '../components/Icon.astro';
import ZoomButton from '../components/ZoomButton.astro';
import { business, serviceGroups, mapsHref, hoursSummary } from '../data/business';
import { galleryBySlug, galleryImages } from '../lib/gallery';
import heroImage from '../assets/hero/hero-carare-color.jpg'; // varianta alb-negru: hero-carare.jpg
import '../styles/home.css';
import '../styles/booking.css';

const title = 'Noir District – Frizerie pentru bărbați în Piatra Neamț';
const description =
  'Noir District by Orlando, frizerie pentru bărbați în Piatra Neamț, pe Strada Mihai Viteazul: skin fade, taper, păr lung și aranjat de barbă. Vezi lucrările și prețurile și programează-te online.';

// Portretul din hero privește spre stânga, spre text. Versiune pregătită special pentru ecran mare:
// alb-negru, curățată de compresia WhatsApp, mărită de 2× (src/assets/hero/).
const heroPhoto = { ...galleryBySlug('carare-skin-fade'), src: heroImage };
const openHours = hoursSummary[0];

const ticker = ['Skin fade', 'Taper fade', 'Cărare tăiată', 'Textured crop', 'Aranjat barbă', 'Contur precis', 'Păr lung'];

const total = String(galleryImages.length).padStart(2, '0');
---

<Base title={title} description={description} page="home">
  <!-- Hero: firma luminată (rama, spotul, sigla) + cadrul cinematic (poza care se topește în negru). -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <figure class="hero-bg">
      <Picture
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        formats={['avif', 'webp']}
        widths={[720, 1080, 1440, 1920, 2300]}
        sizes="(min-width: 48rem) 60vw, 100vw"
        quality={90}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="hero-frame" aria-hidden="true">
      <span class="frame-corner frame-tl"></span>
      <span class="frame-corner frame-tr"></span>
      <span class="frame-corner frame-bl"></span>
      <span class="frame-corner frame-br"></span>
    </div>

    <div class="container hero-content">
      <Logo variant="lockup" link={false} eager width={380} class="hero-lockup" />
      <p class="hero-words" aria-hidden="true">
        <span>Precizie.</span>
        <span>Stil.</span>
        <span><em>Noir.</em></span>
      </p>
      <h1 id="hero-title" class="hero-title">Frizerie pentru bărbați în {business.address.city}</h1>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary" href="#programare">Programează-te</a>
        <a class="btn btn-ghost" href="#preturi">Vezi prețurile</a>
      </div>
    </div>

    <div class="hero-foot">
      <a href={mapsHref} target="_blank" rel="noopener"><Icon name="pin" size={15} /> {business.address.street}</a>
      <span><Icon name="clock" size={15} /> {openHours.days} {openHours.hours}</span>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="ticker-track">
        {ticker.map((t) => <li>{t}</li>)}
      </ul>
    ))}
  </div>

  <section class="works" id="lucrari" aria-labelledby="lucrari-title">
    <div class="works-pin" data-center="fill">
      <div class="container works-head">
        <div>
          <p class="eyebrow" data-reveal>Lucrări</p>
          <h2 id="lucrari-title" data-split>Din scaunul nostru</h2>
        </div>
        <p class="works-count" aria-hidden="true"><b>01</b> / {total}</p>
      </div>
      <ul class="works-track" data-lightbox-group>
        {galleryImages.map((img, i) => (
          <li class="work">
            <figure>
              <Picture
                src={img.src}
                alt={img.alt}
                formats={['avif', 'webp']}
                widths={[360, 540, 720, 960]}
                sizes="(min-width: 64rem) 50svh, (min-width: 48rem) 42vw, 86vw"
                loading="lazy"
                decoding="async"
              />
              <ZoomButton src={img.src} alt={img.alt} title={img.title} />
              <figcaption>
                <span class="gallery-num">{String(i + 1).padStart(2, '0')}</span>
                {img.title}
              </figcaption>
            </figure>
          </li>
        ))}
        <li class="work work-more">
          <a href="/galerie/">
            <span>Toată galeria</span>
            <Icon name="arrow" size={28} />
          </a>
        </li>
      </ul>
      {/* Telefon: bara de progres a caruselului (completată de scripts/home-mobile.ts). */}
      <div class="works-progress" aria-hidden="true">
        <span class="works-progress-bar"><span></span></span>
        <span class="works-progress-count"><b>01</b> / {total}</span>
      </div>
    </div>
  </section>

  <section class="section prices" id="preturi" aria-labelledby="preturi-title">
    <div class="container">
      <Frame class="board" data-center>
        <header class="board-head">
          <p class="eyebrow eyebrow-center">Barbershop · Frizerie</p>
          <h2 id="preturi-title">Prețuri</h2>
          <p class="ornament" aria-hidden="true"><span></span></p>
        </header>
        {/* Telefon: câte o categorie odată (file). Fără JavaScript se văd toate. */}
        <div class="board-tabs" role="tablist" aria-label="Categorii de servicii" hidden>
          {serviceGroups.map((group, i) => (
            <button type="button" role="tab" class="board-tab" id={`fila-${i}`} aria-controls={`grupa-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
              {group.title}
            </button>
          ))}
        </div>
        <div class="board-groups">
          {serviceGroups.map((group, i) => (
            <section class="board-group" id={`grupa-${i}`} aria-labelledby={`grup-${i}`}>
              <h3 id={`grup-${i}`} class="board-group-title">{group.title}</h3>
              <ServiceList services={group.services} headingLevel="h4" />
            </section>
          ))}
        </div>
        <p class="board-note">Durata e orientativă.</p>
      </Frame>
    </div>
  </section>

  <section class="section booking-section" id="programare" aria-labelledby="programare-title">
    <div class="container" data-center>
      <div class="booking-head">
        <p class="eyebrow" data-reveal>Programare</p>
        <h2 id="programare-title" data-split>Rezervă-ți locul pe scaun</h2>
        <p class="lead" data-reveal>Alege serviciul, ziua și ora. Vezi orele libere în timp real; confirmarea vine pe email.</p>
      </div>
      <div data-reveal>
        <Booking />
      </div>
    </div>
  </section>

  <section class="section location-section" id="contact" aria-labelledby="locatie-title">
    <div class="container" data-center>
      <div class="section-head">
        <div>
          <p class="eyebrow" data-reveal>Locație și program</p>
          <h2 id="locatie-title" data-split>Te așteptăm pe Mihai Viteazul</h2>
        </div>
      </div>
      <Location headingLevel="h3" stagger />
    </div>
  </section>
</Base>

<script>
  // Tabla de prețuri încape pe un ecran (independent de animații); pe telefon: file și progresul galeriei.
  import '../scripts/fit';
  import '../scripts/home-mobile';
</script>
