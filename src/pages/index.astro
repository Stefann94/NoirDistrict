---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import ServiceList from '../components/ServiceList.astro';
import Booking from '../components/Booking.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import Icon from '../components/Icon.astro';
import { business, serviceGroups } from '../data/business';
import '../styles/home.css';
import '../styles/booking.css';

const title = 'Noir District – Frizerie pentru bărbați în Piatra Neamț';
const description =
  'Frizerie pentru bărbați în Piatra Neamț: tunsori clasice și moderne, skin fade, aranjat de barbă și bărbierit cu prosop cald. Vezi prețurile și programează-te online.';

const haircuts = serviceGroups.find((g) => g.title === 'Tuns')?.services ?? [];
const beard = serviceGroups.find((g) => g.title === 'Barbă')?.services ?? [];
---

<Base title={title} description={description} experience>
  <Experience slot="stage" />

  <section class="chapter chapter-intro" data-chapter="intro" style="--len: 220svh">
    <div class="container chapter-pin">
      <div class="panel">
        <p class="eyebrow">Barbershop · {business.address.city}</p>
        <h1 class="intro-title">
          <span class="intro-brand">{business.name}</span>
          <span class="intro-sub">Frizerie pentru bărbați în Piatra Neamț</span>
        </h1>
        <p class="lead">Tunsori precise, bărbi conturate cu briciul și timp pentru tine. Fără grabă, fără compromisuri.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#programare">Programează-te</a>
          <a class="btn btn-ghost" href="/servicii/">Vezi prețurile</a>
        </div>
        <p class="scroll-hint">Coboară</p>
      </div>
    </div>
  </section>

  <section class="chapter" data-chapter="clipper" style="--len: 260svh" aria-labelledby="tuns-title">
    <div class="container chapter-pin">
      <div class="panel">
        <p class="eyebrow">Tuns</p>
        <h2 id="tuns-title">Executat la milimetru</h2>
        <ServiceList services={haircuts} compact />
        <a class="link-arrow" href="/servicii/">Toate prețurile <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="chapter" data-chapter="fade" style="--len: 480svh" aria-labelledby="fade-title">
    <div class="container chapter-pin">
      <div class="panel">
        <p class="eyebrow">Semnătura casei</p>
        <h2 id="fade-title">Anatomia unui fade</h2>
        <ol class="stops">
          <li class="stop" style="--from: 0.04; --to: 0.36">
            <span class="stop-num">01</span>
            <h3>Conturul</h3>
            <p>Linia de la ceafă și din jurul urechilor, trasă cu trimmerul. De aici pornește totul.</p>
          </li>
          <li class="stop" style="--from: 0.36; --to: 0.68">
            <span class="stop-num">02</span>
            <h3>Degradeul</h3>
            <p>De la piele la lungime, fără nicio linie vizibilă. Răbdare și mână sigură.</p>
          </li>
          <li class="stop" style="--from: 0.68; --to: 1.2">
            <span class="stop-num">03</span>
            <h3>Textura</h3>
            <p>Creștetul lucrat cu foarfeca, ca tunsoarea să stea bine și a doua zi.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="chapter" data-chapter="razor" style="--len: 260svh" aria-labelledby="barba-title">
    <div class="container chapter-pin">
      <div class="panel">
        <p class="eyebrow">Barbă și bărbierit</p>
        <h2 id="barba-title">Meserie, nu bandă rulantă</h2>
        <!-- PLACEHOLDER: povestea reală, scrisă împreună cu Orlando -->
        <p class="lead">
          {business.owner} lucrează cu programare, ca fiecare client să aibă timpul de care are nevoie: prosop cald,
          brici și un contur curat.
        </p>
        <ServiceList services={beard} compact />
      </div>
    </div>
  </section>

  <section class="booking-section" id="programare" data-chapter="booking" aria-labelledby="programare-title">
    <div class="container">
      <div class="booking-head">
        <p class="eyebrow">Programare</p>
        <h2 id="programare-title">Rezervă-ți locul pe scaun</h2>
        <p class="lead">Alege serviciul, ziua și ora. Cererea ajunge direct la {business.owner} pe WhatsApp.</p>
      </div>
      <Booking />
    </div>
  </section>

  <div class="solid">
    <section class="section" aria-labelledby="galerie-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Galerie</p>
            <h2 id="galerie-title">Lucrări recente</h2>
          </div>
          <a class="link-arrow" href="/galerie/">Toată galeria <Icon name="arrow" size={18} /></a>
        </div>
        <Gallery limit={6} />
      </div>
    </section>

    <section class="section" aria-labelledby="locatie-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Locație și program</p>
            <h2 id="locatie-title">Te așteptăm în {business.address.city}</h2>
          </div>
        </div>
        <Location headingLevel="h3" />
      </div>
    </section>
  </div>
</Base>
