---
import { formatPrice, type Service } from '../data/business';

interface Props {
  services: Service[];
  /** Nivelul titlului fiecărui serviciu, ca ierarhia de titluri să rămână corectă. */
  headingLevel?: 'h3' | 'h4';
}

const { services, headingLevel: H = 'h3' } = Astro.props;
---

<ul class="services">
  {services.map((s) => (
    <li class="service">
      <div class="service-line">
        <H class="service-name">{s.name}</H>
        <span class="service-dots" aria-hidden="true"></span>
        <p class="service-price">{formatPrice(s.price)}</p>
      </div>
      <p class="service-desc">
        {s.description} <span class="service-time">· {s.duration} min</span>
      </p>
    </li>
  ))}
</ul>
