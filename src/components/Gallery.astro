---
// `carousel`: pe mobil carusel orizontal cu scroll-snap (fără JavaScript), pe desktop rând de 3.
// `grid`: grilă pe toate ecranele (pagina Galerie).
import { Picture } from 'astro:assets';
import { galleryImages } from '../lib/gallery';
import ZoomButton from './ZoomButton.astro';

interface Props {
  /** Doar aceste poze, în ordinea dată (după numele fișierului, fără număr). */
  slugs?: string[];
  layout?: 'carousel' | 'grid';
}

const { slugs, layout = 'carousel' } = Astro.props;
const images = slugs
  ? slugs.map((s) => galleryImages.find((i) => i.slug === s)).filter((i) => i !== undefined)
  : galleryImages;
---

{images.length > 0 && (
  <ul class:list={['gallery', `gallery-${layout}`]} aria-label="Lucrări Noir District" data-lightbox-group>
    {images.map((img, i) => (
      <li>
        <figure>
          <Picture
            src={img.src}
            alt={img.alt}
            formats={['avif', 'webp']}
            widths={[360, 540, 720, 960]}
            sizes={layout === 'grid'
              ? '(min-width: 64rem) 23rem, (min-width: 40rem) 45vw, 92vw'
              : '(min-width: 64rem) 23rem, (min-width: 48rem) 30vw, 78vw'}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ 'data-img': '' }}
          />
          <ZoomButton src={img.src} alt={img.alt} title={img.title} />
          <figcaption>
            <span class="gallery-num">{String(i + 1).padStart(2, '0')}</span>
            {img.title}
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
)}
