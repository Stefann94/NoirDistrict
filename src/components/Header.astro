---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, bookingHref, telHref } from '../data/business';
import { sections, sectionHref } from '../data/nav';

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container header-inner">
    <Logo />

    <nav class="header-nav" aria-label="Navigare principală">
      <ul>
        {sections.map((s) => (
          <li>
            <a
              href={sectionHref(s.id)}
              data-section={s.id}
              aria-current={'page' in s && path === s.page ? 'page' : undefined}
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-primary header-cta" href={bookingHref} data-section="programare">Programează-te</a>

    <a class="header-call" href={telHref} aria-label={`Sună la ${business.phoneDisplay}`}>
      <Icon name="phone" />
    </a>
  </div>
</header>
