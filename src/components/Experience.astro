---
// Pânza fixă din spatele primei pagini. Three.js se descarcă abia după ce pagina e complet
// încărcată și browserul e liber: nu afectează prima afișare, nici SEO-ul.
---

<div class="stage" aria-hidden="true">
  <canvas id="stage"></canvas>
</div>

<script>
  const root = document.documentElement;
  const canvas = document.querySelector<HTMLCanvasElement>('#stage');

  const hasWebGL2 = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };

  if (canvas && root.classList.contains('fx')) {
    if (!hasWebGL2()) {
      root.classList.remove('fx');
    } else {
      const start = () =>
        import('../scripts/experience/stage')
          .then((m) => m.startStage(canvas))
          .catch(() => root.classList.remove('fx'));
      const whenIdle = () =>
        'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 200);
      if (document.readyState === 'complete') whenIdle();
      else addEventListener('load', whenIdle, { once: true });
    }
  }
</script>
