---
// Formular de programare fără server: cererea pleacă pe WhatsApp către frizerie, gata completată.
// Zilele și orele se generează în browser, din programul din business.ts.
import { business, serviceGroups, formatPrice, telHref } from '../data/business';

const config = {
  hours: business.hours,
  slotMinutes: business.slotMinutes,
  days: business.bookingDays,
  whatsapp: business.whatsapp,
};
---

{
  business.bookingUrl ? (
    <div class="booking booking-external">
      <a class="btn btn-primary" href={business.bookingUrl} target="_blank" rel="noopener">
        Alege ora online
      </a>
    </div>
  ) : (
    <form class="booking" id="booking-form" data-config={JSON.stringify(config)} novalidate>
      {/* Telefon: asistent pas cu pas (activat de scripts/booking.ts). Pe desktop rămâne ascuns. */}
      <div class="wizard" data-wizard hidden>
        <div class="wizard-top">
          <span class="wizard-count" data-wizard-count>Pasul 1 din 4</span>
          <span class="wizard-title" data-wizard-title>Serviciul</span>
        </div>
        <div class="wizard-bar" aria-hidden="true"><span data-wizard-bar></span></div>
        <ul class="wizard-picks" data-wizard-picks aria-label="Ce ai ales"></ul>
      </div>

      <fieldset class="booking-step">
        <legend><span>1</span> Serviciul</legend>
        <div class="choices">
          {serviceGroups.flatMap((g) =>
            g.services.map((s) => (
              <label class="choice">
                <input type="radio" name="service" value={s.name} data-duration={s.duration} data-price={s.price} required />
                <span class="choice-name">{s.name}</span>
                <span class="choice-meta">{formatPrice(s.price)} · {s.duration} min</span>
              </label>
            )),
          )}
        </div>
      </fieldset>

      <fieldset class="booking-step">
        <legend><span>2</span> Ziua</legend>
        <div class="chips chips-days" data-days></div>
      </fieldset>

      <fieldset class="booking-step">
        <legend><span>3</span> Ora</legend>
        <div class="chips chips-slots" data-slots>
          <p class="booking-hint">Alege întâi ziua.</p>
        </div>
      </fieldset>

      <fieldset class="booking-step">
        <legend><span>4</span> Datele tale</legend>
        <div class="fields">
          <div class="field">
            <label for="booking-name">Nume și prenume</label>
            <input
              id="booking-name"
              name="name"
              autocomplete="name"
              autocapitalize="words"
              spellcheck="false"
              enterkeyhint="next"
              maxlength="40"
              placeholder="ex. Andrei Popescu"
              aria-describedby="booking-name-error"
              required
            />
            <p class="field-error" id="booking-name-error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="booking-phone">Telefon</label>
            <input
              id="booking-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              enterkeyhint="send"
              maxlength="20"
              placeholder="07xx xxx xxx"
              aria-describedby="booking-phone-error"
              required
            />
            <p class="field-error" id="booking-phone-error" aria-live="polite"></p>
          </div>
        </div>
        {/* Capcană pentru roboți: invizibilă pentru oameni, completată doar de programele automate. */}
        <div class="booking-trap" aria-hidden="true">
          <label>Site web <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
      </fieldset>

      <div class="wizard-nav" data-wizard-nav hidden>
        <button type="button" class="btn btn-ghost" data-wizard-back>Înapoi</button>
        <button type="button" class="btn btn-primary" data-wizard-next>Continuă</button>
      </div>

      <p class="booking-error" data-error role="alert"></p>
      {/* Rezervă, dacă serverul nu poate trimite cererea: clientul nu rămâne blocat. */}
      <div class="booking-fallback" data-fallback hidden>
        <a class="btn btn-ghost" data-fallback-whatsapp href="#" target="_blank" rel="noopener">Trimite pe WhatsApp</a>
        <a class="btn btn-ghost" href={telHref}>Sună</a>
      </div>

      <button class="btn btn-primary booking-submit" type="submit">Trimite cererea</button>
      <p class="booking-note">
        Cererea ajunge direct la {business.owner}, care te sună sau îți scrie ca să confirme. Preferi să suni?
        <a href={telHref}>{business.phoneDisplay}</a>
      </p>
      <noscript>
        <p class="booking-note">
          Formularul are nevoie de JavaScript. Ne poți suna la <a href={telHref}>{business.phoneDisplay}</a>.
        </p>
      </noscript>
    </form>
  )
}

{!business.bookingUrl && (
  <div class="booking booking-done" data-booking-done hidden tabindex="-1" role="status">
    <span class="booking-done-mark" aria-hidden="true"></span>
    <h3>Cererea a ajuns la {business.owner}</h3>
    <p class="booking-done-lead">Te contactează în curând, telefonic sau pe WhatsApp, ca să confirme programarea.</p>
    <dl class="booking-done-summary">
      <div><dt>Serviciu</dt><dd data-done="service"></dd></div>
      <div><dt>Când</dt><dd data-done="when"></dd></div>
      <div><dt>Nume</dt><dd data-done="name"></dd></div>
      <div><dt>Telefon</dt><dd data-done="phone"></dd></div>
    </dl>
    <button class="btn btn-ghost" type="button" data-done-again>Altă programare</button>
  </div>
)}

<script>
  import { initBooking } from '../scripts/booking';
  const form = document.querySelector<HTMLFormElement>('#booking-form');
  if (form) initBooking(form);
</script>
