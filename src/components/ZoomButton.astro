---
// Butonul mic din colțul pozei care o deschide mărită (Lightbox.astro).
// Pe calculator apare doar la trecerea mouse-ului peste poză; pe telefon (fără hover) rămâne vizibil, discret.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
// Varianta mare: rezoluția maximă disponibilă (fără mărire artificială), WebP de calitate.
const full = await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 86 });
---

<button
  type="button"
  class="zoom-btn"
  data-lightbox
  data-full={full.src}
  data-alt={alt}
  data-title={title}
  aria-label={`Vezi poza mărită: ${title}`}
>
  <Icon name="expand" size={15} />
</button>
